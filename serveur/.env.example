# Port d'écoute du service
PORT=4310

# Fichier SQLite (chemin absolu ou relatif au dossier veille/)
VEILLE_DB=./veille.db

# Intervalle de collecte automatique, en minutes
COLLECT_EVERY_MIN=30

# Délai minimal entre deux collectes forcées depuis le bouton « Actualiser », en secondes
REFRESH_COOLDOWN_S=20

# Origines autorisées pour le widget (séparées par des virgules).
# Laisser vide pour n'autoriser que la même origine que l'API.
ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:5500

# Jeton pour déclencher la collecte depuis un cron système :
#   curl -H "X-Veille-Token: $VEILLE_TOKEN" -X POST http://localhost:4310/api/refresh
VEILLE_TOKEN=

# Optionnel : NewsAPI en complément des flux RSS (https://newsapi.org)
# Sans clé, seuls les flux RSS sont interrogés.
NEWSAPI_KEY=
NEWSAPI_QUERY=("système d'information" OR "systèmes d'information" OR ERP OR "DSI") AND (informatique OR numérique)

# ---- Le journal : stockage durable ----
# Les entrées que VOUS écrivez vivent à part des articles de veille : ceux-ci se
# recollectent seuls, vos textes non. Sans réglage ci-dessous, elles vont dans un
# fichier local (journal.db) — parfait en développement, éphémère sur Render.
#
# Pour qu'elles survivent aux redéploiements et se partagent entre appareils,
# créez une base gratuite sur https://turso.tech puis renseignez :
# JOURNAL_DB_URL=libsql://votre-base-votre-compte.turso.io
# JOURNAL_DB_TOKEN=le-jeton-donné-par-turso

# ---- La rédaction des résumés ----
# Le résumé d'un flux RSS est une accroche : tronquée, souvent en anglais.
# Avec une clé, le journal demande à Claude deux ou trois phrases en français
# au moment où vous versez une actualité dans votre journal. Sans clé, il se
# contente du résumé nettoyé — aucune erreur, juste moins élégant.
# Compter environ 0,6 centime par actualité réécrite.
ANTHROPIC_API_KEY=
# Plafond de sécurité : nombre de rédactions par heure (défaut 40).
REDACTION_MAX_PAR_HEURE=40
